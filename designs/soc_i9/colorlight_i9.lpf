IOBUF PORT "sdram_a[5]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_a[6]" SITE "A14";
IOBUF PORT "sdram_a[6]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
