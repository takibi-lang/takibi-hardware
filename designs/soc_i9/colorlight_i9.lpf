# Colorlight i9 v7.2: pins of the Linux SoC (issue #21). SDRAM (EM638325-6H)
# and SPI flash pins as in litex-boards' colorlight_i5.py (i9 v7.2), which
# follows wuxx/Colorlight-FPGA-Projects. CS#, CKE and DQM of the SDRAM are
# tied on the board; the flash clock is the configuration clock (USRMCLK).

LOCATE COMP "clock" SITE "P3";
IOBUF PORT "clock" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clock" 25 MHZ;
LOCATE COMP "uart_tx" SITE "J17";
IOBUF PORT "uart_tx" IO_TYPE=LVCMOS33;
LOCATE COMP "uart_rx" SITE "H18";
IOBUF PORT "uart_rx" IO_TYPE=LVCMOS33;
LOCATE COMP "led_n" SITE "L2";
IOBUF PORT "led_n" IO_TYPE=LVCMOS33 DRIVE=4;
LOCATE COMP "flash_cs_n" SITE "R2";
IOBUF PORT "flash_cs_n" IO_TYPE=LVCMOS33;
LOCATE COMP "flash_mosi" SITE "W2";
IOBUF PORT "flash_mosi" IO_TYPE=LVCMOS33;
LOCATE COMP "flash_miso" SITE "V2";
IOBUF PORT "flash_miso" IO_TYPE=LVCMOS33;
LOCATE COMP "sdram_clk" SITE "B9";
IOBUF PORT "sdram_clk" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_a[0]" SITE "B13";
IOBUF PORT "sdram_a[0]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_a[1]" SITE "C14";
IOBUF PORT "sdram_a[1]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
LOCATE COMP "sdram_a[2]" SITE "A16";
IOBUF PORT "sdram_a[2]" IO_TYPE=LVCMOS33 SLEWRATE=FAST;
