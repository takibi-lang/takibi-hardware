# Colorlight i9 v7.2: the JTAG test design (issue #10). The JTAG pins are
# the dedicated configuration pins; only the clock and the LED are placed.
LOCATE COMP "clock" SITE "P3";
IOBUF PORT "clock" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clock" 25 MHZ;
LOCATE COMP "led_n" SITE "L2";
IOBUF PORT "led_n" IO_TYPE=LVCMOS33 DRIVE=4;
