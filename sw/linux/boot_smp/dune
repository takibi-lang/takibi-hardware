; The boot ROM (sw/linux/boot/boot.S) for two harts (#9). boot.S is copied
; here so that its #include "soc_map.h" finds this directory's header.

(rule
 (targets soc_map.h)
 (action
  (with-stdout-to
   soc_map.h
   (run %{exe:../../../models/soc_model/bin/gen.exe} header 2))))

(rule
 (targets boot.S)
 (action
  (copy ../boot/boot.S boot.S)))

(rule
 (targets boot.bin boot.elf)
 (deps boot.S ../boot/link.ld soc_map.h)
 (action
  (progn
   (run riscv-none-elf-gcc -march=rv32ima_zicsr_zifencei -mabi=ilp32 -nostdlib
    -nostartfiles -mno-relax -Wl,--no-warn-rwx-segments -I. -T ../boot/link.ld -o
    boot.elf boot.S)
   (run riscv-none-elf-objcopy -O binary boot.elf boot.bin))))
